# ===== প্রতিটি ক্লায়েন্টের জন্য এই ফাইল কপি করে `.env` বানান (.env কখনো গিটে দেবেন না) =====
APP_NAME="NexMart"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# ডাটাবেস (cPanel → MySQL Databases থেকে বানান)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# শেয়ার্ড cPanel হোস্টিংয়ের জন্য নিরাপদ ডিফল্ট (ক্যাশে শুধু প্লেইন অ্যারে ব্যবহার হয়)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram, Facebook Pixel, কুরিয়ার API, bKash/Nagad নম্বর ইত্যাদি .env-এ নয়,
# অ্যাডমিন প্যানেলের Store Settings থেকে দিন।
